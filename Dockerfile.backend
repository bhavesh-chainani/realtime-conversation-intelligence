FROM python:3.13-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt requirements-diarization.txt /app/
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -r /app/requirements.txt
# Nemotron diarisation for the STT relay (adds torch): --build-arg INSTALL_DIARIZATION=true, then run
# with DIARIZATION_BACKEND=nemotron and the weights mounted at DIARIZATION_MODEL.
ARG INSTALL_DIARIZATION=false
RUN if [ "$INSTALL_DIARIZATION" = "true" ]; then \
      pip install --no-cache-dir -r /app/requirements.txt -r /app/requirements-diarization.txt; \
    fi

COPY backend /app/backend
COPY config.json /app/config.json
# Demo scenarios (used with DEMO_MODE=true)
COPY demo /app/demo

RUN mkdir -p /data
ENV SQLITE_DB_PATH=/data/sessions.db
ENV STORAGE_BACKEND=sqlite

EXPOSE 8000

CMD ["uvicorn", "backend.api:app", "--host", "0.0.0.0", "--port", "8000"]
