# AssemblyAI for realtime transcription
ASSEMBLYAI_API_KEY=

# LiteLLM / OpenAI-compatible proxy configuration for all LLM tasks
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
ROUTER_MODEL=gpt-4o-mini
SUGGESTION_MODEL=gpt-4o-mini
EXTRACTION_MODEL=gpt-4o-mini
SQL_LOOKUP_MODEL=gpt-4o-mini
SUGGESTION_TEMPERATURE=0.3
MAX_SUGGESTIONS=1
# Latency controls: retries per LLM call, optional reasoning effort for GPT-5-family models
# (none|minimal|low; empty = provider default), per-call suggestion timeout and output cap.
LLM_MAX_RETRIES=2
LLM_REASONING_EFFORT=
SUGGESTION_TIMEOUT_SECONDS=20
SUGGESTION_MAX_TOKENS=900
# single = one merged LLM call (fast, demo default); router = router agent + suggestion agent
SUGGESTION_PIPELINE=

# Auth mode
REQUIRE_API_AUTH=false
API_AUTH_TOKEN=
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# Restrict backend CORS origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000

# Usage guardrails
RATE_LIMIT_PER_MINUTE=30
DAILY_REQUEST_QUOTA=2000

# Session persistence: sqlite | dynamodb | none
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=data/sessions.db
DYNAMODB_CONVERSATIONS_TABLE=
AWS_REGION=us-east-1

# Async inference jobs (Day 5) — set ASYNC_JOBS_ENABLED=true + run worker container
ASYNC_JOBS_ENABLED=false
JOB_STORE_BACKEND=sqlite
INFERENCE_QUEUE_MODE=poll
AWS_SQS_INFERENCE_QUEUE_URL=

# Customer history lookup (read-only Postgres view)
CUSTOMER_HISTORY_DATABASE_URL=
CUSTOMER_HISTORY_VIEW=public.customer_history_view
CUSTOMER_HISTORY_QUERY_TIMEOUT_MS=2500
CUSTOMER_HISTORY_MAX_ROWS=10
# Optional extra view columns returned with the customer (demo view exposes: address)
CUSTOMER_HISTORY_EXTRA_COLUMNS=

# Observability (Day 6–8)
LOG_JSON=false
LOG_LEVEL=INFO
APP_VERSION=
GIT_SHA=
METRICS_ENABLED=false
STRICT_READINESS=false
METRICS_TOKEN=

# Frontend: baking async requires rebuild (Docker build-args) — see Dockerfile.frontend
NEXT_PUBLIC_USE_ASYNC_JOBS=false

# Scripted live demo (see docs/DEMO_RUNBOOK.md): /demo/* endpoints, warm cache, prewarm.
# Demo recommendations: DEMO_MODE=true LLM_REASONING_EFFORT=none LLM_MAX_RETRIES=1
# SUGGESTION_TIMEOUT_SECONDS=6 RATE_LIMIT_PER_MINUTE=600 CUSTOMER_HISTORY_EXTRA_COLUMNS=address
# Frontend: NEXT_PUBLIC_DEMO_MODE=true in frontend/.env.local (or open the app with ?demo=1)
DEMO_MODE=false
