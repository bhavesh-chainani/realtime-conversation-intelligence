# AssemblyAI streaming transcription (the words; speakers come from Nemotron)
ASSEMBLYAI_API_KEY=

# Speaker diarisation: NVIDIA Nemotron 3 Diarization in the backend relay
# (pip install -r requirements.txt -r requirements-diarization.txt; weights via scripts/setup_gpu_host.sh).
# Defaults depend on the device: cuda -> low_latency (1.04 s), fp32, 1500 ms max wait;
# cpu -> 40x4 (3.5 s), int8, 6000 ms. If the model fails to load, turns arrive without speakers.
DIARIZATION_DEVICE=cpu
DIARIZATION_MODEL=
DIARIZATION_MODE=
DIARIZATION_INT8=
DIARIZATION_THREADS=4
DIARIZATION_MAX_WAIT_MS=
# Signs relay tickets; set the same value on every backend instance behind a load balancer.
STT_TICKET_SECRET=

# LiteLLM / OpenAI-compatible proxy for both agents
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
SUGGESTION_MODEL=gpt-4o-mini
EXTRACTION_MODEL=gpt-4o-mini
SUGGESTION_TEMPERATURE=0.3
MAX_SUGGESTIONS=1
# Latency controls: retries per LLM call, optional reasoning effort for GPT-5-family models
# (none|minimal|low; empty = provider default), per-call suggestion timeout and output cap.
LLM_MAX_RETRIES=2
LLM_REASONING_EFFORT=
SUGGESTION_TIMEOUT_SECONDS=20
SUGGESTION_MAX_TOKENS=900

# Customer DB lookup (read-only Postgres view; python scripts/demo_db.py prints local values)
CUSTOMER_HISTORY_DATABASE_URL=
CUSTOMER_HISTORY_VIEW=public.customer_history_view
CUSTOMER_HISTORY_QUERY_TIMEOUT_MS=2500
CUSTOMER_HISTORY_MAX_ROWS=10
# Optional extra view columns returned with the customer (the demo view exposes: address)
CUSTOMER_HISTORY_EXTRA_COLUMNS=

# Browser origins allowed to call the backend (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000
