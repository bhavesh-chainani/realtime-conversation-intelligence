# Copy to .env and fill in. Every value has a default in backend/config.py except the keys and URLs.

# --- Transcription: AssemblyAI streaming (the words) ---
ASSEMBLYAI_API_KEY=
# u3-rt-pro hears spoken NRICs correctly; the standard model does not.
ASSEMBLYAI_SPEECH_MODEL=u3-rt-pro
# Extra terms to listen for (comma-separated, max 100)
ASSEMBLYAI_KEYTERMS=
ASSEMBLYAI_END_OF_TURN_SILENCE_MS=240
ASSEMBLYAI_MAX_TURN_SILENCE_MS=1000

# --- Diarisation: Nemotron 3 Diarization (who said each word) ---
# Defaults depend on the device: cuda -> low_latency (1.04 s), fp32, 1500 ms max wait;
# cpu -> 40x4 (3.5 s), int8, 6000 ms. If the model fails to load, turns arrive without speakers.
DIARIZATION_DEVICE=cpu
# Local folder or Hugging Face id; defaults to data/models/Nemotron-3-Diarization when present
DIARIZATION_MODEL=
DIARIZATION_MODE=
DIARIZATION_INT8=
DIARIZATION_THREADS=4
DIARIZATION_MAX_WAIT_MS=
# Signs relay tickets; set the same value on every backend instance behind a load balancer.
STT_TICKET_SECRET=

# --- LLM: LiteLLM / OpenAI-compatible proxy for both agents ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
# Reasoning effort for GPT-5-family models (none|minimal|low; empty = provider default)
LLM_REASONING_EFFORT=
SUGGESTION_MODEL=gpt-4o-mini
SUGGESTION_TEMPERATURE=0.3
MAX_SUGGESTIONS=1
SUGGESTION_TIMEOUT_SECONDS=20
SUGGESTION_MAX_TOKENS=900
EXTRACTION_MODEL=gpt-4o-mini
EXTRACTION_TIMEOUT_SECONDS=20

# --- Customer DB: read-only Postgres view (python scripts/demo_db.py prints local values) ---
CUSTOMER_HISTORY_DATABASE_URL=
CUSTOMER_HISTORY_VIEW=public.customer_history_view
CUSTOMER_HISTORY_QUERY_TIMEOUT_MS=2500
CUSTOMER_HISTORY_MAX_ROWS=10
# Extra view columns returned with the customer (the demo view exposes: address)
CUSTOMER_HISTORY_EXTRA_COLUMNS=

# --- Server ---
# Browser origins allowed to call the backend (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000
